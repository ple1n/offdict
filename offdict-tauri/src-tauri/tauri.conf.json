{
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "removeUnusedCommands": true
  },
  "identifier": "com.anon.offdict",
  "productName": "offdict-tauri",
  "version": "0.2.3",
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "offdict-tauri",
        "width": 800
      }
    ]
  },
  "bundle": {
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}